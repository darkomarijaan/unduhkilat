{
  "manifest_version": 3,
  "name": "UnduhKilat",
  "version": "0.1.5",
  "description": "Kirim unduhan dan media dari browser ke UnduhKilat. Tidak ada yang diunduh sebelum Anda mengonfirmasi di aplikasi.",
  "minimum_chrome_version": "110",
  "key": "",
  "permissions": ["nativeMessaging", "downloads", "cookies", "webRequest", "storage", "tabs", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "UnduhKilat",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
